    "@wdio/mocha-framework": "^8.29.0",
    "@wdio/spec-reporter": "^8.29.0",
    "appium": "^2.5.0",
    "appium-uiautomator2-driver": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webdriverio": "^8.29.0"
  }
}